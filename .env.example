# oh-my-sage 网页版配置文件
# 复制为 .env 后填写，不要提交 .env。

# ==================== LLM 配置 ====================

# OpenAI 兼容接口地址和模型名称，可选服务商见 README「方式二：网页版」
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-terra

# 你的 API Key，必填
LLM_API_KEY=

# 温度（可选，默认 0.7）
# LLM_TEMPERATURE=0.7

# ==================== 网关配置 ====================

# 米家中枢网关地址，必填，例如 http://192.168.0.5
GATEWAY_URL=
