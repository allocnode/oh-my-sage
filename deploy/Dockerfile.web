# oh-my-sage 网页版（Next.js）Docker 镜像
#
# 构建：docker build -f deploy/Dockerfile.web -t oh-my-sage-web:local .
# 运行：参见 deploy/docker-compose.yml（oh-my-sage-web 服务）
#
# 网页版是没有账号系统的 Next.js 应用，只在局域网使用，不要暴露到公网。

# ==================== 构建阶段 ====================
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
# 跳过 install 脚本：构建不需要原生可选依赖（bufferutil 等）
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ==================== 运行阶段 ====================
FROM node:22-alpine
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
WORKDIR /app

# next start 运行只需要编译产物、运行时依赖与配置文件；src/ 已编译进 .next
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/next.config.js ./next.config.js

# 会话存储目录（SessionStore 写 process.cwd()/.sessionstore），compose 里挂卷持久化
RUN mkdir -p .sessionstore && chown -R node:node /app

USER node
EXPOSE 3000

CMD ["npm", "start"]
