# oh-my-sage MCP Server - Docker 部署配置（私有服务器 / NAS）
# 复制为 deploy/.env 后填写，不要提交 .env。
# 下面的值都是留空的，必须换成你自己的；MCP_AUTH_TOKEN 和 MCP_ALLOWED_HOSTS 留空时 docker compose 会拒绝启动。

# 米家中枢网关地址，例如 http://192.168.0.5
# 留空也能启动，但第一次连接网关时要把地址告诉 AI Agent
GATEWAY_URL=

# 访问密码：客户端连接时携带的 Bearer token，必填
# 生成方式：openssl rand -hex 32
MCP_AUTH_TOKEN=

# 其他电脑访问这台服务器时使用的 IP 或域名，必填，多个用英文逗号隔开，不带端口
# 例如 192.168.0.10,nas.local；漏掉的地址访问时会被 Host 校验拒绝（403）
MCP_ALLOWED_HOSTS=

# 宿主机映射端口
MCP_PORT=3790

# 会话空闲回收时间（分钟），可选
# MCP_SESSION_TTL_MINUTES=30
