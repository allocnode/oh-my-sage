# oh-my-sage MCP Server - Docker 部署配置（私有服务器 / NAS）
# 复制为 deploy/.env 后修改，不要提交 .env。

# 米家网关局域网地址
GATEWAY_URL=http://192.168.0.5

# 客户端连接时携带的 Bearer token，生成方式：openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# 客户端访问服务器时使用的主机名或 IP（逗号分隔），否则请求会被 Host 校验拒绝（403）
MCP_ALLOWED_HOSTS=192.168.0.10,nas.local

# 宿主机映射端口
MCP_PORT=3790

# 会话空闲回收时间（分钟），可选
# MCP_SESSION_TTL_MINUTES=30
